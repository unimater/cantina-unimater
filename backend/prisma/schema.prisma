generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Produto {
    id                      String    @id @default(cuid())
    descricao               String
    valor                   Decimal
    situacao                Boolean
    imagem                  String?
    quantidadeEstoque       Decimal @default(0)
    estoqueMinimo           Decimal @default(0)

    categoria   Categoria @relation(fields: [categoriaId], references: [id])  
    categoriaId String    @map("categoria_id")

    movimentacaoEstoque MovimentacaoEstoque[]

    createdBy   String    @map("created_by")
    user        User      @relation(fields: [createdBy], references: [id])
    
    createdAt   DateTime  @default(now()) @map("created_at")
    updatedAt   DateTime? @updatedAt @map("updated_at")

    vendaProduto VendaProduto[]
    itens        PedidoItem[]
}

model Categoria {
  id          String        @id @default(cuid())
  descricao   String
  tipo        TipoCategoria
  situacao    Boolean

  produtos    Produto[]

  createdBy String    @map("created_by")
  user      User      @relation(fields: [createdBy], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
}

enum TipoCategoria {
  PRODUTO
  DESPESA
}

model Despesa {
  id             String     @id @default(cuid())
  descricao      String     @unique                                                     
  data           DateTime                                    
  valor          Decimal               
  fornecedor     String?                   
  observacoes    String?

  createdBy      String     @map("created_by")
  user           User       @relation(fields: [createdBy], references: [id])  

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt      @map("updated_at")
}

model User {
  id              String     @id @default(cuid())
  cpf             String     @unique @db.VarChar(20)
  name            String     @db.VarChar(200)
  username        String     @unique @db.VarChar(100)
  password        String     @db.VarChar(200)
  email           String?    @db.VarChar(200)
  phone           String?    @db.VarChar(20)
  active          Boolean    @default(true)

  movimentacaoEstoque MovimentacaoEstoque[]

  created_by   String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime?    @updatedAt

  resetToken       String?     
  resetTokenExpiry DateTime?   
  venda Venda[]

  produtos         Produto[]
  categorias       Categoria[]
  despesas         Despesa[]
  formasPagamento  formasPagamento[]
  pedidos          Pedido[]
}

model FormasPagamento {
  id          String     @id @default(cuid())
  name        String
  status      Boolean    @default(true)

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime?  @updatedAt      @map("updated_at")

  pedidos     Pedido[]

  createdBy    String       @map("created_by")
  user         User         @relation(fields: [createdBy], references: [id])

  createdAt    DateTime     @default(now())
  updatedAt    DateTime?    @updatedAt

  venda Venda[]
}

model Pedido {
  id                 String           @id @default(cuid())
  descricao          String
  total              Decimal
  categoria          String?
  situacao           Boolean?
  status             StatusPedido     @default(FINALIZADO)
  dataPedido         DateTime         @default(now())
  motivoCancelamento String?
  dataCancelamento   DateTime?

  usuarioId          String?          @map("usuario_id")
  usuario            User?            @relation(fields: [usuarioId], references: [id])

  formaPagamentoId   String?          @map("forma_pagamento_id")
  formaPagamento     FormasPagamento? @relation(fields: [formaPagamentoId], references: [id])

  itens              PedidoItem[]     // itens do pedido

  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime?        @updatedAt      @map("updated_at")
}

model PedidoItem {
  id             String   @id @default(cuid())
  quantidade     Int
  precoUnitario  Decimal
  subtotal       Decimal

  produtoId      String
  produto        Produto @relation(fields: [produtoId], references: [id])

  pedidoId       String
  pedido         Pedido  @relation(fields: [pedidoId], references: [id])
}

enum StatusPedido {
  FINALIZADO
  CANCELADO
}

model Venda {
  id                 String            @id @default(cuid())
  valorTotalVenda    Decimal           @map("valor_total_venda")
  valorTotalDesconto Decimal           @map("valor_total_desconto")
  valorLiquido       Decimal           @map("valor_liquido")

  formaPagamento     formasPagamento   @relation(fields: [formaPagamentoId], references: [id])
  formaPagamentoId   String

  usuario            User              @relation(fields: [usuarioId], references: [id])
  usuarioId          String

  produtos           VendaProduto[]

  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime?         @updatedAt      @map("updated_at")
}

model VendaProduto {
  id             String   @id @default(cuid())

  produto        Produto  @relation(fields: [produtoId], references: [id])
  produtoId      String

  venda          Venda    @relation(fields: [vendaId], references: [id])
  vendaId        String

  quantidade     Int

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt     @map("updated_at")
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

model MovimentacaoEstoque {
  id                String @id @default(cuid())

  produto           Produto @relation(fields: [produtoId], references: [id])
  produtoId         String @map("produtoId")

  usuario           User @relation(fields: [usuarioId], references: [id])
  usuarioId         String @map("usuarioId")

  tipo              TipoMovimentacao
  motivo            String @db.VarChar(255)
  quantidade        Decimal @db.Decimal(15, 2)
  estoqueAnterior   Decimal @db.Decimal(15, 2)
  estoqueAtual      Decimal @db.Decimal(15, 2)
  observacoes       String? @db.VarChar(255)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime? @updatedAt
}
